# Copie para .env e preencha localmente. Nunca commite valores reais.
# O app Android compila e funciona sem estas variáveis (IA permanece desativada).

# --- App (opcional; deixe vazio para modo 100% local) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Edge Functions (somente servidor; nunca no app) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_MS=8000

# --- Script administrativo generate-activation-code ---
ADMIN_SECRET=change-me-to-a-long-random-string
ACTIVATION_CODE_PEPPER=optional-server-side-pepper
