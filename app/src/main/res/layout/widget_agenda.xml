<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_kicker"
        android:textColor="@color/widget_accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_empty_title"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_empty_when"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />

    <!-- O botão "Falar" é a ação principal do widget e fica na tela inicial, na mão dela:
         com wrap_content + 8dp de padding ele saía com ~33dp, o menor alvo de toque do
         app. O minHeight do XML vale mesmo com wrap_content e garante os 56dp; o padding é
         em dp e não muda com a fonte do sistema — quem cresce é o texto de 16sp. -->
    <TextView
        android:id="@+id/widget_speak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:minHeight="56dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        android:text="@string/shortcut_speak"
        android:textColor="@color/widget_on_accent"
        android:textSize="16sp" />
</LinearLayout>
