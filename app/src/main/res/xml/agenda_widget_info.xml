<?xml version="1.0" encoding="utf-8"?>
<!-- 2x3, e não 2x2: a parte fixa do layout (padding 12+12, kicker 12sp, "quando" 13sp, 6 de
     margem e o botão "Falar" de 56dp) já pede ~117dp antes do título da próxima tarefa.
     Em 2 células o widget recebe 110dp: o título, que é quem cede, encolhia até zero e a
     base do botão era cortada — e toque fora dos limites do root não chega no widget, ou
     seja, o alvo de 56dp voltava a ser menor. 180dp = 3 células na tabela oficial dá as
     duas linhas do título e os 56dp inteiros do botão.

     A largura mínima subiu de 110dp para 150dp junto com a fonte (12/13/16sp -> 16/16/18sp):
     com os tamanhos novos a 110dp a parte fixa (kicker 16sp, "quando" 16sp em até 3 linhas e
     o botão de 56dp) come o height inteiro e o título colapsa para 12px, menos que a linha de
     21px dele — o texto da próxima tarefa sumia, pior do que antes. A 130dp o título volta a
     aparecer, mas "Tomar remédio de pressão" ainda sai com 8 caracteres em reticências. A
     150dp nada trunca: o título de duas linhas e o "quando" de duas linhas cabem nos 180dp.
     Medido inflando e medindo o layout em cada largura (WidgetFonteTest). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_agenda"
    android:minWidth="150dp"
    android:minHeight="180dp"
    android:previewLayout="@layout/widget_agenda"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
